# ТехБлог - Environment Variables Example
# Скопируйте этот файл в .env и заполните значения

# Хеш пароля администратора (РЕКОМЕНДУЕТСЯ для production)
# Сгенерируйте хеш командой: node -e "require('bcryptjs').hash('ваш_пароль', 12).then(console.log)"
# ADMIN_PASSWORD_HASH=$2a$12$...ваш_хеш...

# Пароль администратора в открытом виде (только для разработки!)
ADMIN_PASSWORD=your_secure_password_here

# URL сайта (для production)
SITE_URL=https://example.com

# Yandex Metrica ID
YANDEX_METRICA_ID=YOUR_METRICA_ID

# Google Analytics ID (опционально)
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
