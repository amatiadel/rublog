---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  
  // Get all unique tags
  const tags = new Set<string>();
  posts.forEach(post => {
    post.data.tags.forEach(tag => tags.add(tag));
  });

  return Array.from(tags).map(tag => ({
    params: { tag },
    props: { 
      tag,
      posts: posts
        .filter(post => post.data.tags.includes(tag))
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    }
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`Тег: ${tag}`} description={`Все статьи с тегом "${tag}" на ТехБлоге`}>
  <section class="max-w-7xl mx-auto px-4 py-12">
    <div class="mb-8">
      <a href="/tags" class="inline-flex items-center gap-2 text-gray-500 dark:text-gray-400 hover:text-primary transition-colors mb-4">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Все теги
      </a>
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">
        #{tag}
      </h1>
      <p class="text-xl text-gray-600 dark:text-gray-300">
        {posts.length} {posts.length === 1 ? 'статья' : posts.length < 5 ? 'статьи' : 'статей'}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map((post) => (
        <a href={`/blog/${post.slug}`} class="group relative rounded-3xl overflow-hidden bg-gray-100 dark:bg-dark-card aspect-[4/3]">
          {post.data.image && (
            <img 
              src={post.data.image} 
              alt={post.data.title}
              class="w-full h-full object-cover absolute inset-0 group-hover:scale-105 transition-transform duration-500"
            />
          )}
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6">
            <time class="text-xs text-white/60 mb-2 block">
              {post.data.pubDate.toLocaleDateString('ru-RU', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            <h2 class="text-xl font-medium text-white leading-snug line-clamp-2 group-hover:text-primary transition-colors">
              {post.data.title}
            </h2>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
