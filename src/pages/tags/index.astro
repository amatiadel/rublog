---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Get all posts and extract unique tags with counts
const posts = await getCollection('blog', ({ data }) => !data.draft);

const tagCounts = new Map<string, number>();
posts.forEach(post => {
  post.data.tags.forEach(tag => {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  });
});

// Sort tags by count (descending) then alphabetically
const sortedTags = Array.from(tagCounts.entries())
  .sort((a, b) => {
    if (b[1] !== a[1]) return b[1] - a[1];
    return a[0].localeCompare(b[0], 'ru');
  });

// Find max count for sizing
const maxCount = Math.max(...Array.from(tagCounts.values()));
---

<BaseLayout title="Все теги" description="Просмотрите все теги статей на ТехБлоге — найдите интересующие вас темы">
  <section class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">Все теги</h1>
    <p class="text-xl text-gray-600 dark:text-gray-300 mb-12">
      Найдено {sortedTags.length} тегов в {posts.length} статьях
    </p>

    <!-- Tag Cloud -->
    <div class="flex flex-wrap gap-3 mb-16">
      {sortedTags.map(([tag, count]) => {
        const size = Math.max(0.8, Math.min(1.5, 0.8 + (count / maxCount) * 0.7));
        return (
          <a 
            href={`/tags/${tag}`}
            class="inline-flex items-center gap-2 px-4 py-2 bg-gray-100 dark:bg-dark-card text-gray-700 dark:text-gray-300 rounded-full hover:bg-primary hover:text-white dark:hover:bg-primary transition-colors"
            style={`font-size: ${size}rem;`}
          >
            <span>{tag}</span>
            <span class="text-xs opacity-60">({count})</span>
          </a>
        );
      })}
    </div>

    <!-- Tags List -->
    <h2 class="text-2xl font-semibold text-gray-900 dark:text-white mb-6">Список тегов</h2>
    <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-4">
      {sortedTags.map(([tag, count]) => (
        <a 
          href={`/tags/${tag}`}
          class="flex items-center justify-between p-4 bg-gray-50 dark:bg-dark-card rounded-2xl hover:bg-gray-100 dark:hover:bg-dark-border transition-colors group"
        >
          <span class="font-medium text-gray-900 dark:text-white group-hover:text-primary transition-colors">
            {tag}
          </span>
          <span class="text-sm text-gray-500 dark:text-gray-400 bg-gray-200 dark:bg-dark-border px-2 py-1 rounded-full">
            {count} {count === 1 ? 'статья' : count < 5 ? 'статьи' : 'статей'}
          </span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
