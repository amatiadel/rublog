---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/data/siteConfig';
---

<BaseLayout title="Контакты" description="Свяжитесь с нами — контактная информация ТехБлога">
  <section class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-8">Контакты</h1>
    
    <p class="text-xl text-gray-600 dark:text-gray-300 mb-12">
      Есть вопросы, предложения или хотите сотрудничать? Мы всегда рады обратной связи!
    </p>

    <div class="grid md:grid-cols-2 gap-8">
      <!-- Contact Info -->
      <div class="space-y-6">
        <h2 class="text-2xl font-semibold text-gray-900 dark:text-white mb-6">Как с нами связаться</h2>
        
        <div class="space-y-4">
          <a 
            href={`mailto:contact@example.com`}
            class="flex items-center gap-4 p-4 bg-gray-50 dark:bg-dark-card rounded-2xl hover:bg-gray-100 dark:hover:bg-dark-border transition-colors"
          >
            <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center">
              <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <div class="font-medium text-gray-900 dark:text-white">Email</div>
              <div class="text-gray-500 dark:text-gray-400">contact@example.com</div>
            </div>
          </a>

          {siteConfig.social.telegram && (
            <a 
              href={`https://t.me/${siteConfig.social.telegram}`}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-4 p-4 bg-gray-50 dark:bg-dark-card rounded-2xl hover:bg-gray-100 dark:hover:bg-dark-border transition-colors"
            >
              <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center">
                <svg class="w-6 h-6 text-primary" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
                </svg>
              </div>
              <div>
                <div class="font-medium text-gray-900 dark:text-white">Telegram</div>
                <div class="text-gray-500 dark:text-gray-400">@{siteConfig.social.telegram}</div>
              </div>
            </a>
          )}

          {siteConfig.social.github && (
            <a 
              href={`https://github.com/${siteConfig.social.github}`}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-4 p-4 bg-gray-50 dark:bg-dark-card rounded-2xl hover:bg-gray-100 dark:hover:bg-dark-border transition-colors"
            >
              <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center">
                <svg class="w-6 h-6 text-primary" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
              </div>
              <div>
                <div class="font-medium text-gray-900 dark:text-white">GitHub</div>
                <div class="text-gray-500 dark:text-gray-400">{siteConfig.social.github}</div>
              </div>
            </a>
          )}
        </div>
      </div>

      <!-- Additional Info -->
      <div class="space-y-6">
        <h2 class="text-2xl font-semibold text-gray-900 dark:text-white mb-6">Сотрудничество</h2>
        
        <div class="bg-gray-50 dark:bg-dark-card rounded-2xl p-6 space-y-4">
          <h3 class="font-semibold text-gray-900 dark:text-white">Гостевые публикации</h3>
          <p class="text-gray-600 dark:text-gray-300">
            Мы открыты для гостевых статей от экспертов в области технологий. 
            Отправьте нам тему и краткое описание вашей статьи.
          </p>
        </div>

        <div class="bg-gray-50 dark:bg-dark-card rounded-2xl p-6 space-y-4">
          <h3 class="font-semibold text-gray-900 dark:text-white">Реклама и партнёрство</h3>
          <p class="text-gray-600 dark:text-gray-300">
            Заинтересованы в размещении рекламы или партнёрстве? 
            Свяжитесь с нами для обсуждения условий.
          </p>
        </div>

        <div class="bg-gray-50 dark:bg-dark-card rounded-2xl p-6 space-y-4">
          <h3 class="font-semibold text-gray-900 dark:text-white">Обратная связь</h3>
          <p class="text-gray-600 dark:text-gray-300">
            Нашли ошибку или есть предложение по улучшению? 
            Мы ценим любую обратную связь от наших читателей.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
