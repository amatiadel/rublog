---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map(post => ({ params: { slug: post.slug }, props: { post, allPosts: posts } }));
}

const { post, allPosts } = Astro.props;
const { Content, headings } = await post.render();
const formattedDate = post.data.pubDate.toLocaleDateString('ru-RU', { year: 'numeric', month: 'long', day: 'numeric' });

// Get similar posts (same tags), fallback to latest posts
let similarPosts = allPosts
  .filter(p => p.slug !== post.slug && p.data.tags.some(tag => post.data.tags.includes(tag)))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

// If no similar posts, show top 2 latest
if (similarPosts.length === 0) {
  similarPosts = allPosts
    .filter(p => p.slug !== post.slug)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 2);
}

// Calculate days ago for each post
function getDaysAgo(date: Date) {
  const now = new Date();
  const diff = now.getTime() - date.getTime();
  const days = Math.floor(diff / (1000 * 60 * 60 * 24));
  if (days === 0) return 'сегодня';
  if (days === 1) return '1 день назад';
  if (days < 5) return `${days} дня назад`;
  return `${days} дней назад`;
}

// Get all tags with counts
const allTags = allPosts.flatMap(p => p.data.tags);
const tagCounts = allTags.reduce((acc, tag) => {
  acc[tag] = (acc[tag] || 0) + 1;
  return acc;
}, {} as Record<string, number>);
const uniqueTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);

const postUrl = Astro.url.href;

// Summary/TL;DR from frontmatter (optional)
const summary = post.data.summary || post.data.tldr;
---

<BaseLayout 
  title={post.data.title} 
  description={post.data.description} 
  image={post.data.image} 
  article={true} 
  publishedTime={post.data.pubDate}
  updatedTime={post.data.updatedDate}
  author={post.data.author}
  tags={post.data.tags}
>
  <div class="max-w-7xl mx-auto px-4 py-12">
    <Breadcrumbs title={post.data.title} />
    
    <div class="flex flex-col lg:flex-row gap-10">
      <!-- Main Content -->
      <article class="flex-1 max-w-3xl relative overflow-visible">
        <div class="absolute -inset-x-[10%] inset-y-0 grid-background pointer-events-none"></div>
        
        <header class="mb-8 text-center relative">
          <div class="flex items-center justify-center gap-4 text-gray-500 dark:text-gray-400 mb-4">
            <span class="font-medium text-primary">{post.data.author}</span>
            <span>•</span>
            <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
          </div>
          <h1 class="text-2xl md:text-4xl font-bold text-gray-900 dark:text-white mb-5 leading-tight">{post.data.title}</h1>
        </header>
        
        {post.data.image && (
          <img 
            src={post.data.image} 
            alt={post.data.title} 
            class="w-full aspect-video object-cover mb-10 shadow-lg relative" 
            width="1200"
            height="630"
            loading="eager"
          />
        )}
        
        <!-- TL;DR / Summary Block for Featured Snippets -->
        {summary && (
          <div class="tldr-block mb-8 p-4 bg-primary/10 border-l-4 border-primary rounded-r-lg">
            <p class="font-semibold text-gray-900 dark:text-white mb-1">TL;DR</p>
            <p class="text-gray-700 dark:text-gray-200 m-0">{summary}</p>
          </div>
        )}
        
        <!-- Table of Contents -->
        <TableOfContents headings={headings} />
        
        <div class="article-content relative">
          <Content />
        </div>
        
        <!-- Share Buttons (End of Post) -->
        <div class="mt-12 pt-8 border-t border-gray-200 dark:border-dark-border">
          <p class="text-gray-600 dark:text-gray-400 mb-4">Поделиться статьёй:</p>
          <div class="flex items-center gap-3 flex-wrap" role="group" aria-label="Кнопки для шаринга">
            <button 
              id="copy-url-btn"
              class="flex items-center gap-2 px-4 py-2 text-sm border border-gray-200 dark:border-dark-border rounded-full text-gray-600 dark:text-gray-300 hover:border-primary hover:text-primary transition-colors"
              aria-label="Копировать ссылку на статью"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/>
              </svg>
              <span id="copy-url-text">Копировать ссылку</span>
            </button>
            <a 
              href={`https://t.me/share/url?url=${encodeURIComponent(postUrl)}&text=${encodeURIComponent(post.data.title)}`}
              target="_blank"
              rel="noopener"
              class="flex items-center gap-2 px-4 py-2 text-sm border border-gray-200 dark:border-dark-border rounded-full text-gray-600 dark:text-gray-300 hover:border-primary hover:text-primary transition-colors"
              aria-label="Поделиться в Telegram"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
              </svg>
              Telegram
            </a>
            <a 
              href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(postUrl)}&text=${encodeURIComponent(post.data.title)}`}
              target="_blank"
              rel="noopener"
              class="flex items-center gap-2 px-4 py-2 text-sm border border-gray-200 dark:border-dark-border rounded-full text-gray-600 dark:text-gray-300 hover:border-primary hover:text-primary transition-colors"
              aria-label="Поделиться в X (Twitter)"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
              X
            </a>
          </div>
        </div>
      </article>

      <!-- Sidebar (Desktop Only) -->
      <aside class="hidden lg:block w-80 shrink-0">
        <div class="lg:sticky lg:top-24 space-y-8">
          <!-- Similar Posts -->
          {similarPosts.length > 0 && (
            <div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Полезные статьи про AI</h3>
              <div class="space-y-5">
                {similarPosts.map(p => (
                  <a href={`/blog/${p.slug}`} class="flex gap-4 group">
                    {p.data.image && (
                      <img src={p.data.image} alt={p.data.title} class="w-24 h-24 object-cover rounded-lg shrink-0" />
                    )}
                    <div class="flex-1 min-w-0">
                      <h4 class="text-base font-medium text-gray-900 dark:text-white group-hover:text-primary transition-colors line-clamp-3 leading-snug">{p.data.title}</h4>
                      <div class="flex items-center gap-1.5 mt-2 text-gray-500 text-sm">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <circle cx="12" cy="12" r="10" stroke-width="1.5"/>
                          <path stroke-linecap="round" stroke-width="1.5" d="M12 6v6l4 2"/>
                        </svg>
                        {getDaysAgo(p.data.pubDate)}
                      </div>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}

          <!-- Categories -->
          <div>
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Категории</h3>
            <div class="space-y-2">
              {uniqueTags.slice(0, 6).map(([tag, count]) => (
                <div class="flex items-center justify-between py-2 text-gray-600 dark:text-gray-300">
                  <span class="capitalize">{tag}</span>
                  <span class="text-gray-500 text-sm">({count})</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Tags -->
          <div>
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Теги</h3>
            <div id="tagsContainer" class="flex flex-wrap gap-2 max-h-[4.5rem] overflow-hidden">
              {uniqueTags.map(([tag]) => (
                <span class="text-sm px-3 py-1 border border-gray-200 dark:border-dark-border text-gray-600 dark:text-gray-300">
                  {tag}
                </span>
              ))}
            </div>
            <button id="expandTags" class="mt-3 text-sm text-primary hover:text-primary/80 transition-colors flex items-center gap-1">
              Раскрыть теги ▼
            </button>
          </div>
        </div>
      </aside>
    </div>
    
    <!-- Similar Posts (Mobile Only) -->
    <div class="lg:hidden mt-12">
      {similarPosts.length > 0 && (
        <div>
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Полезные статьи про AI</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {similarPosts.map(p => (
              <a href={`/blog/${p.slug}`} class="flex gap-3 group">
                {p.data.image && (
                  <img src={p.data.image} alt={p.data.title} class="w-20 h-20 object-cover rounded-lg shrink-0" />
                )}
                <div class="flex-1 min-w-0">
                  <h4 class="text-sm font-medium text-gray-700 dark:text-gray-200 group-hover:text-primary transition-colors line-clamp-2">{p.data.title}</h4>
                  <time class="text-xs text-gray-500 mt-1 block">
                    {p.data.pubDate.toLocaleDateString('ru-RU', { day: 'numeric', month: 'short' })}
                  </time>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</BaseLayout>

<script define:vars={{ postUrl }}>
  document.addEventListener('DOMContentLoaded', () => {
    // Copy URL button
    const copyBtn = document.getElementById('copy-url-btn');
    const copyText = document.getElementById('copy-url-text');
    
    if (copyBtn && copyText) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(postUrl);
          copyText.textContent = 'Скопировано!';
          setTimeout(() => {
            copyText.textContent = 'Копировать ссылку';
          }, 2000);
        } catch (err) {
          console.error('Failed to copy:', err);
        }
      });
    }

    // Copy button and collapse for code blocks
    document.querySelectorAll('.article-content pre').forEach((pre) => {
      const code = pre.querySelector('code');
      if (!code) return;
      
      // Count characters
      const charCount = code.textContent?.length || 0;
      const charLimit = 300;
      
      // Add copy button
      const copyBtn = document.createElement('button');
      copyBtn.className = 'copy-btn';
      copyBtn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>Копировать`;
      
      // Copy button handler with fallback
      copyBtn.onclick = async function(e) {
        e.stopPropagation();
        e.preventDefault();
        
        const text = code.textContent || '';
        let success = false;
        
        try {
          // Try modern clipboard API first
          if (navigator.clipboard && window.isSecureContext) {
            await navigator.clipboard.writeText(text);
            success = true;
          } else {
            // Fallback for older browsers or non-HTTPS
            const textArea = document.createElement('textarea');
            textArea.value = text;
            textArea.style.position = 'fixed';
            textArea.style.left = '-999999px';
            textArea.style.top = '-999999px';
            document.body.appendChild(textArea);
            textArea.focus();
            textArea.select();
            
            try {
              success = document.execCommand('copy');
            } catch (err) {
              console.error('execCommand failed:', err);
            }
            
            document.body.removeChild(textArea);
          }
          
          if (!success) {
            throw new Error('Copy failed');
          }
        } catch (err) {
          console.error('Copy failed:', err);
          alert('Не удалось скопировать. Попробуйте выделить текст вручную.');
        }
        return false;
      };
      
      pre.appendChild(copyBtn);
      
      // Add collapse functionality if more than character limit
      if (charCount > charLimit) {
        pre.classList.add('collapsible');
        code.classList.add('collapsed');
        
        // Make code area clickable but not the button
        code.style.cursor = 'pointer';
        
        // Only toggle when clicking the code itself
        code.addEventListener('click', (e) => {
          if (e.target === code || code.contains(e.target)) {
            code.classList.toggle('collapsed');
          }
        });
      }
    });

    // Expand tags
    const tagsContainer = document.getElementById('tagsContainer');
    const expandBtn = document.getElementById('expandTags');
    let expanded = false;
    
    if (expandBtn && tagsContainer) {
      expandBtn.addEventListener('click', () => {
        expanded = !expanded;
        if (expanded) {
          tagsContainer.style.maxHeight = 'none';
          expandBtn.innerHTML = 'Скрыть теги ▲';
        } else {
          tagsContainer.style.maxHeight = '4.5rem';
          expandBtn.innerHTML = 'Раскрыть теги ▼';
        }
      });
    }
  });
</script>


<style is:global>
  .grid-background {
    background-size: 24px 24px;
    background-image: 
      linear-gradient(to right, rgba(0, 0, 0, 0.04) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(0, 0, 0, 0.04) 1px, transparent 1px);
    -webkit-mask-image: linear-gradient(to right, transparent, black 15%, black 85%, transparent),
                        linear-gradient(to bottom, transparent, black 5%, black 95%, transparent);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to right, transparent, black 15%, black 85%, transparent),
                linear-gradient(to bottom, transparent, black 5%, black 95%, transparent);
    mask-composite: intersect;
  }
  
  .dark .grid-background {
    background-image: 
      linear-gradient(to right, rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
  }

  .article-content {
    color: #374151;
    font-size: 1.05rem;
    line-height: 1.8;
  }
  
  .dark .article-content,
  .dark .article-content p,
  .dark .article-content li,
  .dark .article-content h2,
  .dark .article-content h3,
  .dark .article-content strong,
  .dark .article-content blockquote {
    color: #EEEEEE !important;
  }
  
  .article-content h2 {
    color: #111827;
    font-size: 1.625rem;
    font-weight: 700;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #e5e7eb;
  }
  
  .dark .article-content h2 {
    border-bottom-color: #393E46;
  }
  
  .article-content h3 {
    color: #111827;
    font-size: 1.26rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  
  .article-content p {
    margin-bottom: 1.5rem;
    color: #374151;
  }
  
  .article-content strong {
    color: #111827;
    font-weight: 600;
  }
  
  .article-content a {
    color: #00ADB5;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  
  .article-content a:hover {
    color: #00CED8;
  }
  
  .article-content ul {
    margin: 1.5rem 0;
    padding: 0;
    list-style: none;
  }
  
  .article-content ul li {
    position: relative;
    padding-left: 0.5rem;
    margin-bottom: 0.75rem;
    color: #374151;
  }
  
  .article-content ol {
    margin: 1.5rem 0;
    padding-left: 1.5rem;
    counter-reset: item;
    list-style: none;
  }
  
  .article-content ol li {
    position: relative;
    padding-left: 0.5rem;
    margin-bottom: 0.75rem;
    color: #374151;
    counter-increment: item;
  }
  
  .article-content ol li::before {
    content: counter(item) ".";
    position: absolute;
    left: -1.5rem;
    color: #00ADB5;
    font-weight: 600;
  }
  
  .article-content blockquote {
    border-left: 4px solid #00ADB5;
    margin: 2rem 0;
    font-style: italic;
    color: #374151;
    background: #f3f4f6;
    padding: 1.5rem;
    border-radius: 0 0.5rem 0.5rem 0;
  }
  
  .dark .article-content blockquote {
    background: #393E46;
  }
  
  .article-content blockquote p {
    margin: 0;
    display: inline;
  }
  
  .article-content h1 {
    color: #111827;
    font-size: 2rem;
    font-weight: 700;
    margin-top: 3rem;
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid #00ADB5;
  }
  
  .dark .article-content h1 {
    color: #EEEEEE;
  }
  
  .article-content blockquote img.emoji {
    display: inline !important;
    vertical-align: -0.15em;
  }
  
  .article-content code {
    background: #f3f4f6;
    padding: 0.2rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.9em;
    color: #00ADB5;
  }
  
  .dark .article-content code {
    background: #393E46;
  }
  
  .article-content pre {
    position: relative;
    background: #ffffff !important;
    padding: 1.5rem;
    border-radius: 0.75rem;
    margin: 1.5rem 0;
    border: 1px solid #000000;
    overflow-x: hidden;
  }
  
  /* Collapsed code block */
  .article-content pre.collapsible code.collapsed {
    max-height: 7.5em; /* ~5 lines */
    overflow: hidden;
    display: block;
    position: relative;
  }
  
  .article-content pre.collapsible code.collapsed::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3em;
    background: linear-gradient(to bottom, transparent, #ffffff);
    pointer-events: none;
  }
  
  .dark .article-content pre.collapsible code.collapsed::after {
    background: linear-gradient(to bottom, transparent, #000000);
  }
  
  /* Shiki dual theme support */
  .article-content pre .shiki,
  .article-content pre .shiki span {
    color: #000000 !important;
    background-color: transparent !important;
  }
  
  .dark .article-content pre .shiki,
  .dark .article-content pre .shiki span {
    color: #ffffff !important;
    background-color: transparent !important;
  }
  
  .article-content pre code {
    white-space: pre-wrap;
    word-wrap: break-word;
    word-break: break-all;
    color: #000000 !important;
    background: transparent !important;
  }
  
  .dark .article-content pre code {
    color: #ffffff !important;
  }
  
  .dark .article-content pre {
    background: #000000 !important;
    border-color: #ffffff;
  }
  
  .article-content pre .copy-btn {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    padding: 0.4rem 0.75rem;
    background: #f3f4f6;
    border: 1px solid #000000;
    border-radius: 0.375rem;
    color: #000000;
    font-size: 0.75rem;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    opacity: 0;
    z-index: 100;
  }
  
  .article-content pre:hover .copy-btn {
    opacity: 1;
  }
  
  .dark .article-content pre .copy-btn {
    background: #1f2937;
    border-color: #ffffff;
    color: #ffffff;
  }
  
  .article-content pre .copy-btn:hover {
    background: #00ADB5;
    color: #000000;
    border-color: #00ADB5;
  }
  
  .article-content pre .copy-btn.copied {
    background: #22c55e;
    color: #fff;
    border-color: #22c55e;
  }
  
  .article-content pre code {
    background: none;
    padding: 0;
    color: #000000;
  }
  
  .dark .article-content pre code {
    color: #e2e8f0;
  }
  
  .article-content hr {
    border: none;
    border-top: 1px solid #e5e7eb;
    margin: 2.5rem 0;
  }
  
  .dark .article-content hr {
    border-top-color: #393E46;
  }
  
  .article-content img {
    border-radius: 0.75rem;
    margin: 2rem 0;
  }
  
  .article-content img.emoji {
    border-radius: 0;
    margin: 0 0.15em;
    display: inline !important;
  }
  
  /* Table Styles - Clean Design */
  .article-content table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    margin: 2rem 0;
    font-size: 0.9rem;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid #e5e7eb;
  }
  
  .dark .article-content table {
    border-color: #393E46;
  }
  
  .article-content thead {
    background: #ffffff;
  }
  
  .dark .article-content thead {
    background: #000000;
  }
  
  .article-content th {
    padding: 1rem 1.25rem;
    text-align: left;
    font-weight: 600;
    color: #111827;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
    border-bottom: 2px solid #00ADB5;
  }
  
  .dark .article-content th {
    color: #EEEEEE;
  }
  
  .article-content th:first-child {
    border-top-left-radius: 11px;
  }
  
  .article-content th:last-child {
    border-top-right-radius: 11px;
