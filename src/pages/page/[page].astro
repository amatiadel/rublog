---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '@/data/siteConfig';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  
  const postsPerPage = siteConfig.postsPerPage;
  const totalPages = Math.ceil(sortedPosts.length / postsPerPage);

  return Array.from({ length: totalPages }, (_, i) => ({
    params: { page: String(i + 1) },
    props: {
      posts: sortedPosts.slice(i * postsPerPage, (i + 1) * postsPerPage),
      currentPage: i + 1,
      totalPages,
      totalPosts: sortedPosts.length
    }
  }));
}

const { posts, currentPage, totalPages, totalPosts } = Astro.props;

// Redirect page 1 to home
if (currentPage === 1) {
  return Astro.redirect('/');
}

// Layout pattern for posts
const row1Big = posts[0];
const row1Small = posts.slice(1, 3);
const row2Small = posts.slice(3, 5);
const row2Big = posts[5];
const remaining = posts.slice(6);
---

<BaseLayout title={`Страница ${currentPage}`} description={`Страница ${currentPage} из ${totalPages} — все статьи ТехБлога`}>
  <section class="max-w-7xl mx-auto px-4 py-8 space-y-4">
    
    <!-- Page Header -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-2">
        Все статьи
      </h1>
      <p class="text-gray-600 dark:text-gray-400">
        Страница {currentPage} из {totalPages} • Всего {totalPosts} статей
      </p>
    </div>

    <!-- Row 1: Big Left + 2 Small Right -->
    {posts.length > 0 && (
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 h-auto lg:h-[500px]">
        {row1Big && (
          <a href={`/blog/${row1Big.slug}`} class="lg:col-span-2 relative group rounded-3xl overflow-hidden bg-gray-100 dark:bg-dark-card min-h-[300px]">
            {row1Big.data.image && (
              <img 
                src={row1Big.data.image} 
                alt={row1Big.data.title}
                class="w-full h-full object-cover absolute inset-0 group-hover:scale-105 transition-transform duration-500"
              />
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-8">
              {row1Big.data.tags[0] && (
                <span class="inline-block text-sm text-white/80 mb-3">{row1Big.data.tags[0]}</span>
              )}
              <h2 class="text-2xl md:text-3xl lg:text-4xl font-light text-white leading-tight mb-4 line-clamp-3">
                {row1Big.data.title}
              </h2>
              <div class="flex items-center gap-4">
                <span class="inline-flex items-center gap-2 px-4 py-2 border border-white/30 rounded-full text-white text-sm hover:bg-white/10 transition-colors">
                  Читать статью
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17"/>
                  </svg>
                </span>
                <span class="text-white/60 text-sm">от {row1Big.data.author}</span>
              </div>
            </div>
          </a>
        )}

        <div class="flex flex-col gap-4">
          {row1Small.map((post) => (
            <a href={`/blog/${post.slug}`} class="relative group rounded-3xl overflow-hidden flex-1 min-h-[240px] bg-gray-100 dark:bg-dark-card">
              {post.data.image && (
                <img 
                  src={post.data.image} 
                  alt={post.data.title}
                  class="w-full h-full object-cover absolute inset-0 group-hover:scale-105 transition-transform duration-500"
                />
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
              <div class="absolute bottom-0 left-0 right-0 p-6">
                {post.data.tags[0] && (
                  <span class="inline-block text-xs text-white/80 mb-2">{post.data.tags[0]}</span>
                )}
                <h3 class="text-xl font-light text-white leading-snug line-clamp-2">
                  {post.data.title}
                </h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Row 2: 2 Small Left + Big Right -->
    {(row2Small.length > 0 || row2Big) && (
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 h-auto lg:h-[500px]">
        <div class="flex flex-col gap-4">
          {row2Small.map((post) => (
            <a href={`/blog/${post.slug}`} class="relative group rounded-3xl overflow-hidden flex-1 min-h-[240px] bg-gray-100 dark:bg-dark-card">
              {post.data.image && (
                <img 
                  src={post.data.image} 
                  alt={post.data.title}
                  class="w-full h-full object-cover absolute inset-0 group-hover:scale-105 transition-transform duration-500"
                />
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
              <div class="absolute bottom-0 left-0 right-0 p-6">
                {post.data.tags[0] && (
                  <span class="inline-block text-xs text-white/80 mb-2">{post.data.tags[0]}</span>
                )}
                <h3 class="text-xl font-light text-white leading-snug line-clamp-2">
                  {post.data.title}
                </h3>
              </div>
            </a>
          ))}
        </div>

        {row2Big && (
          <a href={`/blog/${row2Big.slug}`} class="lg:col-span-2 relative group rounded-3xl overflow-hidden bg-gray-100 dark:bg-dark-card min-h-[300px]">
            {row2Big.data.image && (
              <img 
                src={row2Big.data.image} 
                alt={row2Big.data.title}
                class="w-full h-full object-cover absolute inset-0 group-hover:scale-105 transition-transform duration-500"
              />
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-8">
              {row2Big.data.tags[0] && (
                <span class="inline-block text-sm text-white/80 mb-3">{row2Big.data.tags[0]}</span>
              )}
              <h2 class="text-2xl md:text-3xl lg:text-4xl font-light text-white leading-tight mb-4 line-clamp-3">
                {row2Big.data.title}
              </h2>
              <div class="flex items-center gap-4">
                <span class="inline-flex items-center gap-2 px-4 py-2 border border-white/30 rounded-full text-white text-sm hover:bg-white/10 transition-colors">
                  Читать статью
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17"/>
                  </svg>
                </span>
                <span class="text-white/60 text-sm">от {row2Big.data.author}</span>
              </div>
            </div>
          </a>
        )}
      </div>
    )}

    <!-- Additional rows -->
    {remaining.length > 0 && (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {remaining.map((post) => (
          <a href={`/blog/${post.slug}`} class="relative group rounded-3xl overflow-hidden aspect-[4/3] bg-gray-100 dark:bg-dark-card">
            {post.data.image && (
              <img 
                src={post.data.image} 
                alt={post.data.title}
                class="w-full h-full object-cover absolute inset-0 group-hover:scale-105 transition-transform duration-500"
              />
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6">
              {post.data.tags[0] && (
                <span class="inline-block text-xs text-white/80 mb-2">{post.data.tags[0]}</span>
              )}
              <h3 class="text-xl font-light text-white leading-snug line-clamp-2">
                {post.data.title}
              </h3>
            </div>
          </a>
        ))}
      </div>
    )}

    <!-- Pagination -->
    <nav class="flex items-center justify-center gap-2 pt-12" aria-label="Пагинация">
      {currentPage > 1 && (
        <a 
          href={currentPage === 2 ? '/' : `/page/${currentPage - 1}`}
          class="inline-flex items-center gap-2 px-4 py-2 text-gray-600 dark:text-gray-300 hover:text-primary transition-colors"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
          Назад
        </a>
      )}

      <div class="flex items-center gap-1">
        {Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => (
          <a
            href={page === 1 ? '/' : `/page/${page}`}
            class={`w-10 h-10 flex items-center justify-center rounded-full transition-colors ${
              page === currentPage
                ? 'bg-primary text-white'
                : 'text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-dark-card'
            }`}
          >
            {page}
          </a>
        ))}
      </div>

      {currentPage < totalPages && (
        <a 
          href={`/page/${currentPage + 1}`}
          class="inline-flex items-center gap-2 px-4 py-2 text-gray-600 dark:text-gray-300 hover:text-primary transition-colors"
        >
          Вперёд
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      )}
    </nav>
  </section>
</BaseLayout>
