---
import BaseLayout from '@/layouts/BaseLayout.astro';

export const prerender = false;

const { slug } = Astro.params;
---

<BaseLayout title="Редактировать статью" description="Редактирование статьи">
  <section class="max-w-4xl mx-auto px-4 py-12">
    <div class="flex items-center justify-between mb-8">
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Редактировать статью</h1>
      <div class="flex items-center gap-4">
        <a href="/admin" class="text-gray-600 dark:text-gray-400 hover:text-primary transition-colors">← Назад</a>
        <a href="/admin/logout" class="px-4 py-2 text-sm text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-dark-border rounded-lg hover:border-red-500 hover:text-red-500 transition-colors">
          Выйти
        </a>
      </div>
    </div>
    
    <div id="loading" class="text-center py-12">
      <div class="animate-spin h-8 w-8 border-4 border-primary border-t-transparent rounded-full mx-auto"></div>
      <p class="text-gray-500 mt-4">Загрузка...</p>
    </div>
    
    <form id="editForm" class="space-y-6 hidden">
      <input type="hidden" name="slug" id="slugInput" value={slug} />
      <input type="hidden" name="pubDate" id="pubDateInput" />
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-gray-700 dark:text-gray-300 mb-2">Заголовок *</label>
          <input type="text" name="title" id="titleInput" required 
            class="w-full px-4 py-3 bg-gray-50 dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-lg text-gray-900 dark:text-white focus:border-primary focus:outline-none" />
        </div>
        
        <div>
          <label class="block text-gray-700 dark:text-gray-300 mb-2">Автор</label>
          <input type="text" name="author" id="authorInput"
            class="w-full px-4 py-3 bg-gray-50 dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-lg text-gray-900 dark:text-white focus:border-primary focus:outline-none" />
        </div>
      </div>
      
      <div>
        <label class="block text-gray-700 dark:text-gray-300 mb-2">Описание *</label>
        <input type="text" name="description" id="descriptionInput" required 
          class="w-full px-4 py-3 bg-gray-50 dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-lg text-gray-900 dark:text-white focus:border-primary focus:outline-none" />
      </div>

      <div>
        <label class="block text-gray-700 dark:text-gray-300 mb-2">Обложка статьи</label>
        <div id="coverDropzone" class="border-2 border-dashed border-gray-300 dark:border-dark-border rounded-lg p-6 text-center cursor-pointer hover:border-primary transition-colors">
          <input type="file" id="coverInput" accept="image/*" class="hidden" />
          <div id="coverPreview" class="hidden mb-4">
            <img id="coverImg" class="max-h-48 mx-auto rounded-lg" />
          </div>
          <p id="coverText" class="text-gray-500 dark:text-gray-400">Перетащите изображение или нажмите для выбора</p>
        </div>
        <input type="hidden" name="image" id="coverUrl" />
      </div>
      
      <div>
        <label class="block text-gray-700 dark:text-gray-300 mb-2">Теги (через запятую)</label>
        <input type="text" name="tags" id="tagsInput" placeholder="технологии, ии, программирование" 
          class="w-full px-4 py-3 bg-gray-50 dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-lg text-gray-900 dark:text-white focus:border-primary focus:outline-none" />
      </div>
      
      <div>
        <label class="block text-gray-700 dark:text-gray-300 mb-2">Контент *</label>
        
        <!-- Toolbar -->
        <div class="flex flex-wrap gap-1 p-2 bg-gray-100 dark:bg-dark-card border border-gray-200 dark:border-dark-border border-b-0 rounded-t-lg">
          <button type="button" data-action="bold" class="toolbar-btn" title="Жирный">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 4h8a4 4 0 014 4 4 4 0 01-4 4H6z M6 12h9a4 4 0 014 4 4 4 0 01-4 4H6z"/></svg>
          </button>
          <button type="button" data-action="italic" class="toolbar-btn" title="Курсив">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 4h4m-2 0v16m-4 0h8"/></svg>
          </button>
          <span class="w-px h-6 bg-gray-300 dark:bg-gray-600 mx-1"></span>
          <button type="button" data-action="h1" class="toolbar-btn text-sm font-bold" title="Заголовок 1">H1</button>
          <button type="button" data-action="h2" class="toolbar-btn text-sm font-semibold" title="Заголовок 2">H2</button>
          <button type="button" data-action="h3" class="toolbar-btn text-sm font-medium" title="Заголовок 3">H3</button>
          <button type="button" data-action="h4" class="toolbar-btn text-xs font-medium" title="Заголовок 4">H4</button>
          <button type="button" data-action="h5" class="toolbar-btn text-xs" title="Заголовок 5">H5</button>
          <button type="button" data-action="h6" class="toolbar-btn text-xs" title="Заголовок 6">H6</button>
          <span class="w-px h-6 bg-gray-300 dark:bg-gray-600 mx-1"></span>
          <button type="button" data-action="ul" class="toolbar-btn" title="Список">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
          </button>
          <button type="button" data-action="ol" class="toolbar-btn" title="Нумерованный список">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h10M7 16h10M3 8h.01M3 12h.01M3 16h.01"/></svg>
          </button>
          <button type="button" data-action="quote" class="toolbar-btn" title="Цитата">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/></svg>
          </button>
          <button type="button" data-action="code" class="toolbar-btn" title="Код">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
          </button>
          <button type="button" data-action="link" class="toolbar-btn" title="Ссылка">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
          </button>
          <span class="w-px h-6 bg-gray-300 dark:bg-gray-600 mx-1"></span>
          <button type="button" data-action="image" class="toolbar-btn" title="Вставить изображение">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          </button>
        </div>
        
        <textarea name="content" id="editor" rows="20" required 
          class="w-full px-4 py-3 bg-gray-50 dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-b-lg text-gray-900 dark:text-white focus:border-primary focus:outline-none font-mono text-sm"></textarea>
      </div>

      <!-- Image upload modal -->
      <div id="imageModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
        <div class="bg-white dark:bg-dark-card rounded-xl p-6 max-w-md w-full">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Вставить изображение</h3>
          <div id="imageDropzone" class="border-2 border-dashed border-gray-300 dark:border-dark-border rounded-lg p-8 text-center cursor-pointer hover:border-primary transition-colors mb-4">
            <input type="file" id="imageInput" accept="image/*" class="hidden" />
            <svg class="w-12 h-12 mx-auto text-gray-400 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <p class="text-gray-500 dark:text-gray-400">Перетащите или нажмите для выбора</p>
          </div>
          <div id="uploadProgress" class="hidden mb-4">
            <div class="h-2 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden">
              <div id="progressBar" class="h-full bg-primary transition-all duration-300" style="width: 0%"></div>
            </div>
            <p class="text-sm text-gray-500 mt-1">Загрузка...</p>
          </div>
          <input type="text" id="imageAlt" placeholder="Описание изображения (alt)" 
            class="w-full px-4 py-2 mb-4 bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border rounded-lg text-gray-900 dark:text-white focus:border-primary focus:outline-none" />
          <div class="flex gap-3">
            <button type="button" id="cancelImage" class="flex-1 py-2 border border-gray-200 dark:border-dark-border text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-100 dark:hover:bg-dark-bg transition-colors">Отмена</button>
            <button type="button" id="insertImage" class="flex-1 py-2 bg-primary text-white rounded-lg hover:bg-primary/80 transition-colors" disabled>Вставить</button>
          </div>
        </div>
      </div>

      <div class="flex gap-4">
        <button type="submit" id="submitBtn"
          class="flex-1 py-3 bg-primary text-white font-semibold rounded-lg hover:bg-primary/80 transition-colors flex items-center justify-center gap-2">
          <span>Сохранить изменения</span>
        </button>
        <button type="button" id="deleteBtn"
          class="px-6 py-3 bg-red-500 text-white font-semibold rounded-lg hover:bg-red-600 transition-colors">
          Удалить
        </button>
      </div>
    </form>
    
    <div id="message" class="mt-4 hidden p-4 rounded-lg"></div>
  </section>
</BaseLayout>

<style>
  .toolbar-btn {
    padding: 0.5rem;
    border-radius: 0.375rem;
    color: #6b7280;
    transition: all 0.2s;
  }
  .toolbar-btn:hover {
    background-color: #e5e7eb;
    color: #111827;
  }
  .dark .toolbar-btn:hover {
    background-color: #393E46;
    color: #fff;
  }
</style>

<script define:vars={{ slug }}>
  const form = document.getElementById('editForm');
  const loading = document.getElementById('loading');
  const editor = document.getElementById('editor');
  const message = document.getElementById('message');
  const submitBtn = document.getElementById('submitBtn');
  const deleteBtn = document.getElementById('deleteBtn');
  
  // Load post data
  async function loadPost() {
    try {
      const res = await fetch(`/api/posts/${slug}`);
      const data = await res.json();
      
      if (!res.ok) throw new Error(data.error);
      
      document.getElementById('titleInput').value = data.title;
      document.getElementById('descriptionInput').value = data.description;
      document.getElementById('authorInput').value = data.author;
      document.getElementById('tagsInput').value = data.tags;
      document.getElementById('pubDateInput').value = data.pubDate;
      document.getElementById('coverUrl').value = data.image || '';
      editor.value = data.content;
      
      if (data.image) {
        document.getElementById('coverImg').src = data.image;
        document.getElementById('coverPreview').classList.remove('hidden');
      }
      
      loading.classList.add('hidden');
      form.classList.remove('hidden');
    } catch (err) {
      loading.innerHTML = `<p class="text-red-500">Ошибка: ${err.message}</p>`;
    }
  }
  
  loadPost();

  // Cover image upload
  const coverDropzone = document.getElementById('coverDropzone');
  const coverInput = document.getElementById('coverInput');
  const coverPreview = document.getElementById('coverPreview');
  const coverImg = document.getElementById('coverImg');
  const coverUrl = document.getElementById('coverUrl');

  coverDropzone.addEventListener('click', () => coverInput.click());
  coverDropzone.addEventListener('dragover', (e) => { e.preventDefault(); coverDropzone.classList.add('border-primary'); });
  coverDropzone.addEventListener('dragleave', () => coverDropzone.classList.remove('border-primary'));
  coverDropzone.addEventListener('drop', async (e) => {
    e.preventDefault();
    coverDropzone.classList.remove('border-primary');
    const file = e.dataTransfer?.files[0];
    if (file) await uploadCover(file);
  });
  coverInput.addEventListener('change', async () => {
    if (coverInput.files?.[0]) await uploadCover(coverInput.files[0]);
  });

  async function uploadCover(file) {
    const formData = new FormData();
    formData.append('image', file);
    
    try {
      const res = await fetch('/api/upload', { method: 'POST', body: formData });
      const data = await res.json();
      
      if (res.ok) {
        coverUrl.value = data.url;
        coverImg.src = data.url;
        coverPreview.classList.remove('hidden');
      } else {
        alert(data.error);
      }
    } catch (err) {
      alert('Ошибка загрузки');
    }
  }

  // Image modal
  const imageModal = document.getElementById('imageModal');
  const imageDropzone = document.getElementById('imageDropzone');
  const imageInput = document.getElementById('imageInput');
  const imageAlt = document.getElementById('imageAlt');
  const insertImageBtn = document.getElementById('insertImage');
  const cancelImageBtn = document.getElementById('cancelImage');
  const uploadProgress = document.getElementById('uploadProgress');
  const progressBar = document.getElementById('progressBar');
  
  let pendingImageUrl = '';

  document.querySelector('[data-action="image"]')?.addEventListener('click', () => {
    imageModal.classList.remove('hidden');
    pendingImageUrl = '';
    imageAlt.value = '';
    insertImageBtn.disabled = true;
    imageDropzone.innerHTML = `
      <svg class="w-12 h-12 mx-auto text-gray-400 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
      <p class="text-gray-500 dark:text-gray-400">Перетащите или нажмите для выбора</p>
    `;
  });

  cancelImageBtn.addEventListener('click', () => imageModal.classList.add('hidden'));
  imageModal.addEventListener('click', (e) => { if (e.target === imageModal) imageModal.classList.add('hidden'); });

  imageDropzone.addEventListener('click', () => imageInput.click());
  imageDropzone.addEventListener('dragover', (e) => { e.preventDefault(); imageDropzone.classList.add('border-primary'); });
  imageDropzone.addEventListener('dragleave', () => imageDropzone.classList.remove('border-primary'));
  imageDropzone.addEventListener('drop', async (e) => {
    e.preventDefault();
    imageDropzone.classList.remove('border-primary');
    const file = e.dataTransfer?.files[0];
    if (file) await uploadContentImage(file);
  });
  imageInput.addEventListener('change', async () => {
    if (imageInput.files?.[0]) await uploadContentImage(imageInput.files[0]);
  });

  async function uploadContentImage(file) {
    const formData = new FormData();
    formData.append('image', file);
    
    uploadProgress.classList.remove('hidden');
    progressBar.style.width = '30%';
    
    try {
      const res = await fetch('/api/upload', { method: 'POST', body: formData });
      progressBar.style.width = '100%';
      const data = await res.json();
      
      if (res.ok) {
        pendingImageUrl = data.url;
        insertImageBtn.disabled = false;
        imageDropzone.innerHTML = `<img src="${data.url}" class="max-h-32 mx-auto rounded" />`;
      } else {
        alert(data.error);
      }
    } catch (err) {
      alert('Ошибка загрузки');
    } finally {
      setTimeout(() => uploadProgress.classList.add('hidden'), 500);
    }
  }

  insertImageBtn.addEventListener('click', () => {
    if (pendingImageUrl) {
      const alt = imageAlt.value || 'Изображение';
      insertText(`\n![${alt}](${pendingImageUrl})\n`);
      imageModal.classList.add('hidden');
    }
  });

  // Toolbar actions
  document.querySelectorAll('.toolbar-btn[data-action]').forEach(btn => {
    btn.addEventListener('click', () => {
      const action = btn.getAttribute('data-action');
      handleToolbarAction(action);
    });
  });

  function handleToolbarAction(action) {
    const start = editor.selectionStart;
    const end = editor.selectionEnd;
    const selected = editor.value.substring(start, end);

    const actions = {
      bold: () => wrapText('**', '**'),
      italic: () => wrapText('*', '*'),
      h1: () => insertAtLineStart('# '),
      h2: () => insertAtLineStart('## '),
      h3: () => insertAtLineStart('### '),
      h4: () => insertAtLineStart('#### '),
      h5: () => insertAtLineStart('##### '),
      h6: () => insertAtLineStart('###### '),
      ul: () => insertAtLineStart('- '),
      ol: () => insertAtLineStart('1. '),
      quote: () => insertAtLineStart('> '),
      code: () => selected.includes('\n') ? wrapText('\n```\n', '\n```\n') : wrapText('`', '`'),
      link: () => {
        const url = prompt('Введите URL:');
        if (url) wrapText('[', `](${url})`);
      }
    };

    actions[action]?.();
  }

  function wrapText(before, after) {
    const start = editor.selectionStart;
    const end = editor.selectionEnd;
    const selected = editor.value.substring(start, end);
    const newText = before + selected + after;
    
    editor.setRangeText(newText, start, end, 'select');
    editor.focus();
  }

  function insertAtLineStart(prefix) {
    const start = editor.selectionStart;
    const lineStart = editor.value.lastIndexOf('\n', start - 1) + 1;
    
    editor.setRangeText(prefix, lineStart, lineStart, 'end');
    editor.focus();
  }

  function insertText(text) {
    const start = editor.selectionStart;
    editor.setRangeText(text, start, start, 'end');
    editor.focus();
  }

  // Form submit
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    submitBtn.innerHTML = '<svg class="animate-spin h-5 w-5" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg><span>Сохранение...</span>';
    
    const formData = new FormData(form);
    
    try {
      const res = await fetch(`/api/posts/${slug}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          title: formData.get('title'),
          description: formData.get('description'),
          author: formData.get('author'),
          image: formData.get('image'),
          tags: formData.get('tags'),
          content: formData.get('content'),
          pubDate: formData.get('pubDate')
        })
      });
      
      const data = await res.json();
      
      if (res.ok) {
        message.className = 'mt-4 p-4 rounded-lg bg-green-500/20 text-green-600 dark:text-green-400';
        message.innerHTML = `Изменения сохранены! <a href="/blog/${slug}" class="underline">Открыть статью</a>`;
        message.classList.remove('hidden');
      } else {
        throw new Error(data.error);
      }
    } catch (err) {
      message.className = 'mt-4 p-4 rounded-lg bg-red-500/20 text-red-600 dark:text-red-400';
      message.textContent = `Ошибка: ${err.message}`;
      message.classList.remove('hidden');
    } finally {
      submitBtn.innerHTML = '<span>Сохранить изменения</span>';
    }
  });

  // Delete post
  deleteBtn.addEventListener('click', async () => {
    if (!confirm('Вы уверены, что хотите удалить эту статью?')) return;
    
    try {
      const res = await fetch(`/api/posts/${slug}`, { method: 'DELETE' });
      const data = await res.json();
      
      if (res.ok) {
        window.location.href = '/admin';
      } else {
        throw new Error(data.error);
      }
    } catch (err) {
      alert(`Ошибка: ${err.message}`);
    }
  });
</script>
