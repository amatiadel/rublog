---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/data/siteConfig';
---

<BaseLayout title="О блоге" description="Блог о Nano Banana Pro от Google — AI для генерации и редактирования фото. Доступ без VPN через Telegram-бот @Nanobaanana_bot">
  <section class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-8">О блоге</h1>
    
    <div class="prose prose-lg dark:prose-invert max-w-none">
      <p class="text-xl text-gray-600 dark:text-gray-300 mb-8">
        {siteConfig.name} — блог о Nano Banana Pro, AI-модели от Google DeepMind для генерации и редактирования изображений. 
        Через Telegram-бот <a href="https://t.me/Nanobaanana_bot" class="text-primary hover:underline">@Nanobaanana_bot</a> 
        вы получаете доступ к этой технологии без VPN с оплатой российскими картами.
      </p>

      <h2 class="text-2xl font-semibold text-gray-900 dark:text-white mt-12 mb-4">Что такое Nano Banana Pro</h2>
      <p class="text-gray-600 dark:text-gray-300 mb-6">
        Nano Banana Pro — это модель генерации изображений от Google, построенная на базе Gemini 3 Pro. 
        Она создаёт студийное качество визуалов с точным текстом на разных языках, поддерживает редактирование 
        и разрешение до 4K. Бот @Nanobaanana_bot — это русскоязычный интерфейс для работы с этой технологией.
      </p>

      <h2 class="text-2xl font-semibold text-gray-900 dark:text-white mt-12 mb-4">Наша миссия</h2>
      <p class="text-gray-600 dark:text-gray-300 mb-6">
        Мы помогаем российским пользователям использовать передовые AI-технологии Google без VPN и зарубежных карт. 
        Публикуем готовые промты, пошаговые инструкции и реальные примеры.
      </p>

      <h2 class="text-2xl font-semibold text-gray-900 dark:text-white mt-12 mb-4">Что мы публикуем</h2>
      <ul class="list-disc list-inside text-gray-600 dark:text-gray-300 space-y-2 mb-6">
        <li>Готовые промты для нейрофотосессий (2000+ вариантов)</li>
        <li>Инструкции по смене одежды на фото с помощью ИИ</li>
        <li>Промты для продуктовых фото на Wildberries и Ozon</li>
        <li>Гайды по дизайну интерьеров с нейросетями</li>
        <li>Промты для мужских и женских AI-фото</li>
      </ul>

      <h2 class="text-2xl font-semibold text-gray-900 dark:text-white mt-12 mb-4">Попробуйте сами</h2>
      <p class="text-gray-600 dark:text-gray-300 mb-6">
        Начните в Telegram-боте <a href="https://t.me/Nanobaanana_bot" class="text-primary hover:underline">@Nanobaanana_bot</a>. 
        Есть бесплатные генерации для старта, оплата российскими картами.
      </p>

      <div class="flex gap-4 mt-8">
        {siteConfig.social.telegram && (
          <a 
            href={`https://t.me/${siteConfig.social.telegram}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-white rounded-full hover:bg-primary/90 transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
            </svg>
            Telegram
          </a>
        )}
        {siteConfig.social.github && (
          <a 
            href={`https://github.com/${siteConfig.social.github}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 border border-gray-300 dark:border-dark-border text-gray-700 dark:text-gray-300 rounded-full hover:bg-gray-100 dark:hover:bg-dark-card transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            GitHub
          </a>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
