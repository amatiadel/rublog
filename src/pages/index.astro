---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '@/data/siteConfig';

// FAQ data for both display and schema
const faqData = [
  {
    question: "Что такое Nano Banana Pro?",
    answer: "Nano Banana Pro — это AI-модель генерации и редактирования изображений от Google DeepMind, построенная на базе Gemini 3 Pro. Создаёт студийное качество фото с точным текстом и разрешением до 4K."
  },
  {
    question: "Что такое @Nanobaanana_bot?",
    answer: "Это Telegram-бот, который даёт доступ к технологии Nano Banana Pro без VPN. Работает с российскими картами, имеет библиотеку из 2000+ готовых промтов на русском языке."
  },
  {
    question: "Нужен ли VPN для использования?",
    answer: "Нет! Бот @Nanobaanana_bot работает напрямую в Telegram без VPN. Просто откройте бота и начните генерировать фото."
  },
  {
    question: "Что такое нейрофотосессия?",
    answer: "Нейрофотосессия — это создание профессиональных фото с помощью ИИ. Вы загружаете своё фото, выбираете стиль из библиотеки промтов, и нейросеть генерирует новое изображение за 30-60 секунд."
  },
  {
    question: "Можно ли поменять одежду на фото с помощью ИИ?",
    answer: "Да! Nano Banana Pro умеет менять одежду на фото. Загружаете исходное фото, описываете нужную одежду в промте, и получаете результат с новым образом."
  },
  {
    question: "Подходит ли для фото товаров на Wildberries и Ozon?",
    answer: "Да, бот отлично подходит для создания продуктовых фото. Можно делать фото на белом фоне, lifestyle-съёмку, разные ракурсы товара для карточек маркетплейсов."
  },
  {
    question: "Можно ли использовать для дизайна интерьера?",
    answer: "Да! Nano Banana Pro генерирует визуализации интерьеров по описанию. Полезно для дизайнеров, риелторов и тех, кто планирует ремонт."
  },
  {
    question: "Какие промты лучше использовать?",
    answer: "В боте есть библиотека из 2000+ готовых промтов с примерами результатов. Выбирайте по категориям: нейрофотосессии, смена одежды, продуктовые фото, дизайн интерьера."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqData.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Pagination
const postsPerPage = siteConfig.postsPerPage;
const totalPages = Math.ceil(allPosts.length / postsPerPage);
const posts = allPosts.slice(0, postsPerPage);

// First row: 1 big left, 2 small right
const row1Big = posts[0];
const row1Small = posts.slice(1, 3);

// Second row: 2 small left, 1 big right
const row2Small = posts.slice(3, 5);
const row2Big = posts[5];

// Remaining posts for more rows
const remaining = posts.slice(6);
---

<BaseLayout title="Главная" description={siteConfig.description} image={row1Big?.data.image}>
  <section class="max-w-7xl mx-auto px-4 py-8 space-y-4">
    
    <!-- Row 1: Big Left + 2 Small Right -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 h-auto lg:h-[500px]">
      <!-- Big Post Left -->
      {row1Big && (
        <a href={`/blog/${row1Big.slug}`} class="lg:col-span-2 relative group rounded-3xl overflow-hidden bg-gray-100 dark:bg-dark-card min-h-[300px]">
          {row1Big.data.image && (
            <img 
              src={row1Big.data.image} 
              alt={row1Big.data.title}
              class="w-full h-full object-cover absolute inset-0 group-hover:scale-105 transition-transform duration-500"
              loading="eager"
              fetchpriority="high"
              width="800"
              height="500"
            />
          )}
          <div class="absolute bottom-0 left-0 right-0 p-8">
            <div class="absolute inset-0 bg-black/40 backdrop-blur-xl rounded-t-3xl" style="mask-image: linear-gradient(to top, black 60%, transparent); -webkit-mask-image: linear-gradient(to top, black 60%, transparent);"></div>
            <div class="relative z-10">
              {row1Big.data.tags[0] && (
                <span class="inline-block text-sm text-white/90 mb-3">{row1Big.data.tags[0]}</span>
              )}
              <h2 class="text-2xl md:text-3xl lg:text-4xl font-light text-white leading-tight mb-4 line-clamp-3">
                {row1Big.data.title}
              </h2>
              <div class="flex items-center gap-4">
                <span class="inline-flex items-center gap-2 px-4 py-2 border border-white/30 rounded-full text-white text-sm hover:bg-white/10 transition-colors">
                  Читать статью
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17"/>
                  </svg>
                </span>
                <span class="text-white/70 text-sm">от {row1Big.data.author}</span>
              </div>
            </div>
          </div>
        </a>
      )}

      <!-- 2 Small Posts Right -->
      <div class="flex flex-col gap-4">
        {row1Small.map((post) => (
          <a href={`/blog/${post.slug}`} class="relative group rounded-3xl overflow-hidden flex-1 min-h-[240px] bg-gray-100 dark:bg-dark-card">
            {post.data.image && (
              <img 
                src={post.data.image} 
                alt={post.data.title}
                class="w-full h-full object-cover absolute inset-0 group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
                width="400"
                height="240"
              />
            )}
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <div class="absolute inset-0 bg-black/40 backdrop-blur-xl rounded-t-2xl" style="mask-image: linear-gradient(to top, black 50%, transparent); -webkit-mask-image: linear-gradient(to top, black 50%, transparent);"></div>
              <div class="relative z-10">
                {post.data.tags[0] && (
                  <span class="inline-block text-xs text-white/90 mb-2">{post.data.tags[0]}</span>
                )}
                <h3 class="text-xl font-light text-white leading-snug line-clamp-2">
                  {post.data.title}
                </h3>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Row 2: 2 Small Left + Big Right -->
    {(row2Small.length > 0 || row2Big) && (
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 h-auto lg:h-[500px]">
        <!-- 2 Small Posts Left -->
        <div class="flex flex-col gap-4">
          {row2Small.map((post) => (
            <a href={`/blog/${post.slug}`} class="relative group rounded-3xl overflow-hidden flex-1 min-h-[240px] bg-gray-100 dark:bg-dark-card">
              {post.data.image && (
                <img 
                  src={post.data.image} 
                  alt={post.data.title}
                  class="w-full h-full object-cover absolute inset-0 group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  width="400"
                  height="240"
                />
              )}
              <div class="absolute bottom-0 left-0 right-0 p-6">
                <div class="absolute inset-0 bg-black/40 backdrop-blur-xl rounded-t-2xl" style="mask-image: linear-gradient(to top, black 50%, transparent); -webkit-mask-image: linear-gradient(to top, black 50%, transparent);"></div>
                <div class="relative z-10">
                  {post.data.tags[0] && (
                    <span class="inline-block text-xs text-white/90 mb-2">{post.data.tags[0]}</span>
                  )}
                  <h3 class="text-xl font-light text-white leading-snug line-clamp-2">
                    {post.data.title}
                  </h3>
                </div>
              </div>
            </a>
          ))}
        </div>

        <!-- Big Post Right -->
        {row2Big && (
          <a href={`/blog/${row2Big.slug}`} class="lg:col-span-2 relative group rounded-3xl overflow-hidden bg-gray-100 dark:bg-dark-card min-h-[300px]">
            {row2Big.data.image && (
              <img 
                src={row2Big.data.image} 
                alt={row2Big.data.title}
                class="w-full h-full object-cover absolute inset-0 group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
                width="800"
                height="500"
              />
            )}
            <div class="absolute bottom-0 left-0 right-0 p-8">
              <div class="absolute inset-0 bg-black/40 backdrop-blur-xl rounded-t-3xl" style="mask-image: linear-gradient(to top, black 60%, transparent); -webkit-mask-image: linear-gradient(to top, black 60%, transparent);"></div>
              <div class="relative z-10">
                {row2Big.data.tags[0] && (
                  <span class="inline-block text-sm text-white/90 mb-3">{row2Big.data.tags[0]}</span>
                )}
                <h2 class="text-2xl md:text-3xl lg:text-4xl font-light text-white leading-tight mb-4 line-clamp-3">
                  {row2Big.data.title}
                </h2>
                <div class="flex items-center gap-4">
                  <span class="inline-flex items-center gap-2 px-4 py-2 border border-white/30 rounded-full text-white text-sm hover:bg-white/10 transition-colors">
                    Читать статью
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17"/>
                    </svg>
                  </span>
                  <span class="text-white/70 text-sm">от {row2Big.data.author}</span>
                </div>
              </div>
            </div>
          </a>
        )}
      </div>
    )}


    <!-- Additional rows if more posts -->
    {remaining.length > 0 && (
      <>
        {/* Group remaining posts in alternating pattern */}
        {Array.from({ length: Math.ceil(remaining.length / 3) }).map((_, rowIndex) => {
          const startIdx = rowIndex * 3;
          const isEvenRow = rowIndex % 2 === 0;
          const bigPost = remaining[startIdx];
          const smallPosts = remaining.slice(startIdx + 1, startIdx + 3);
          
          return isEvenRow ? (
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 h-auto lg:h-[500px]">
              {bigPost && (
                <a href={`/blog/${bigPost.slug}`} class="lg:col-span-2 relative group rounded-3xl overflow-hidden bg-gray-100 dark:bg-dark-card min-h-[300px]">
                  {bigPost.data.image && (
                    <img src={bigPost.data.image} alt={bigPost.data.title} class="w-full h-full object-cover absolute inset-0 group-hover:scale-105 transition-transform duration-500" loading="lazy" width="800" height="500" />
                  )}
                  <div class="absolute bottom-0 left-0 right-0 p-8">
                    <div class="absolute inset-0 bg-black/40 backdrop-blur-xl rounded-t-3xl" style="mask-image: linear-gradient(to top, black 60%, transparent); -webkit-mask-image: linear-gradient(to top, black 60%, transparent);"></div>
                    <div class="relative z-10">
                      {bigPost.data.tags[0] && <span class="inline-block text-sm text-white/90 mb-3">{bigPost.data.tags[0]}</span>}
                      <h2 class="text-2xl md:text-3xl lg:text-4xl font-light text-white leading-tight mb-4 line-clamp-3">{bigPost.data.title}</h2>
                    </div>
                  </div>
                </a>
              )}
              <div class="flex flex-col gap-4">
                {smallPosts.map((post) => (
                  <a href={`/blog/${post.slug}`} class="relative group rounded-3xl overflow-hidden flex-1 min-h-[240px] bg-gray-100 dark:bg-dark-card">
                    {post.data.image && <img src={post.data.image} alt={post.data.title} class="w-full h-full object-cover absolute inset-0 group-hover:scale-105 transition-transform duration-500" loading="lazy" width="400" height="240" />}
                    <div class="absolute bottom-0 left-0 right-0 p-6">
                      <div class="absolute inset-0 bg-black/40 backdrop-blur-xl rounded-t-2xl" style="mask-image: linear-gradient(to top, black 50%, transparent); -webkit-mask-image: linear-gradient(to top, black 50%, transparent);"></div>
                      <div class="relative z-10">
                        {post.data.tags[0] && <span class="inline-block text-xs text-white/90 mb-2">{post.data.tags[0]}</span>}
                        <h3 class="text-xl font-light text-white leading-snug line-clamp-2">{post.data.title}</h3>
                      </div>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 h-auto lg:h-[500px]">
              <div class="flex flex-col gap-4">
                {smallPosts.map((post) => (
                  <a href={`/blog/${post.slug}`} class="relative group rounded-3xl overflow-hidden flex-1 min-h-[240px] bg-gray-100 dark:bg-dark-card">
                    {post.data.image && <img src={post.data.image} alt={post.data.title} class="w-full h-full object-cover absolute inset-0 group-hover:scale-105 transition-transform duration-500" loading="lazy" width="400" height="240" />}
                    <div class="absolute bottom-0 left-0 right-0 p-6">
                      <div class="absolute inset-0 bg-black/40 backdrop-blur-xl rounded-t-2xl" style="mask-image: linear-gradient(to top, black 50%, transparent); -webkit-mask-image: linear-gradient(to top, black 50%, transparent);"></div>
                      <div class="relative z-10">
                        {post.data.tags[0] && <span class="inline-block text-xs text-white/90 mb-2">{post.data.tags[0]}</span>}
                        <h3 class="text-xl font-light text-white leading-snug line-clamp-2">{post.data.title}</h3>
                      </div>
                    </div>
                  </a>
                ))}
              </div>
              {bigPost && (
                <a href={`/blog/${bigPost.slug}`} class="lg:col-span-2 relative group rounded-3xl overflow-hidden bg-gray-100 dark:bg-dark-card min-h-[300px]">
                  {bigPost.data.image && <img src={bigPost.data.image} alt={bigPost.data.title} class="w-full h-full object-cover absolute inset-0 group-hover:scale-105 transition-transform duration-500" loading="lazy" width="800" height="500" />}
                  <div class="absolute bottom-0 left-0 right-0 p-8">
                    <div class="absolute inset-0 bg-black/40 backdrop-blur-xl rounded-t-3xl" style="mask-image: linear-gradient(to top, black 60%, transparent); -webkit-mask-image: linear-gradient(to top, black 60%, transparent);"></div>
                    <div class="relative z-10">
                      {bigPost.data.tags[0] && <span class="inline-block text-sm text-white/90 mb-3">{bigPost.data.tags[0]}</span>}
                      <h2 class="text-2xl md:text-3xl lg:text-4xl font-light text-white leading-tight mb-4 line-clamp-3">{bigPost.data.title}</h2>
                    </div>
                  </div>
                </a>
              )}
            </div>
          );
        })}
      </>
    )}
  </section>

    <!-- Pagination -->
    {totalPages > 1 && (
      <nav class="flex items-center justify-center gap-2 pt-12" aria-label="Пагинация">
        <div class="flex items-center gap-1">
          {Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => (
            <a
              href={page === 1 ? '/' : `/page/${page}`}
              class={`w-10 h-10 flex items-center justify-center rounded-full transition-colors ${
                page === 1
                  ? 'bg-primary text-white'
                  : 'text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-dark-card'
              }`}
            >
              {page}
            </a>
          ))}
        </div>

        {totalPages > 1 && (
          <a 
            href="/page/2"
            class="inline-flex items-center gap-2 px-4 py-2 text-gray-600 dark:text-gray-300 hover:text-primary transition-colors"
          >
            Вперёд
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        )}
      </nav>
    )}
  </section>

  <!-- Q&A Section -->
  <section class="max-w-3xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-semibold text-gray-900 dark:text-white mb-8 text-center">Часто задаваемые вопросы</h2>
    <div class="divide-y divide-gray-200 dark:divide-dark-border">
      {faqData.map((item) => (
        <details class="group py-5">
          <summary class="flex items-center justify-between cursor-pointer list-none">
            <span class="text-lg text-gray-900 dark:text-white">{item.question}</span>
            <svg class="w-5 h-5 text-gray-400 group-open:rotate-45 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v16m8-8H4"/>
            </svg>
          </summary>
          <p class="mt-3 text-gray-500 dark:text-gray-400">{item.answer}</p>
        </details>
      ))}
    </div>
  </section>
  
  <!-- FAQPage Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</BaseLayout>
