---
import { siteConfig } from '@/data/siteConfig';
---

<footer class="bg-white dark:bg-dark-bg border-t border-gray-200 dark:border-dark-border mt-auto transition-colors duration-300">
  <div class="max-w-6xl mx-auto px-4 py-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <p class="text-gray-600 dark:text-gray-400 text-sm">
        © {new Date().getFullYear()} {siteConfig.name}. Все права защищены.
      </p>
      <nav class="flex flex-wrap items-center justify-center gap-4 text-sm">
        <a href="/about" class="text-gray-600 dark:text-gray-400 hover:text-primary dark:hover:text-primary transition-colors">
          О блоге
        </a>
        <a href="/tags" class="text-gray-600 dark:text-gray-400 hover:text-primary dark:hover:text-primary transition-colors">
          Теги
        </a>
        <a href="/contact" class="text-gray-600 dark:text-gray-400 hover:text-primary dark:hover:text-primary transition-colors">
          Контакты
        </a>
        <a href="/privacy" class="text-gray-600 dark:text-gray-400 hover:text-primary dark:hover:text-primary transition-colors">
          Конфиденциальность
        </a>
        <a href={`https://t.me/${siteConfig.social.telegram}`} class="text-gray-600 dark:text-gray-400 hover:text-primary dark:hover:text-primary transition-colors" target="_blank" rel="noopener">
          Telegram
        </a>
      </nav>
    </div>
  </div>
</footer>
